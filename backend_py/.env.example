MILVUS_URI=http://localhost:19530

# 模型规模：vitB / vitL / vitG（越大越准、越慢、越占显存）
MODEL_TYPE=vitB

# MinIO 对象存储（dense_features token 持久化，须与 docker-compose 一致）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=echo_campus
MINIO_SECRET_KEY=echo_campus
MINIO_BUCKET=image
# MINIO_SECURE=true          # 仅生产 HTTPS 开启
# MINIO_INTERNAL_HOST=minio:9000  # 仅 Docker 容器内使用
